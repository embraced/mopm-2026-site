---
import Base from '../layouts/Base.astro';
import AgendaDesktop from '../components/AgendaDesktop.astro';
import AgendaMobile from '../components/AgendaMobile.astro';
import { loadAgenda } from '../lib/agenda';
const agenda = loadAgenda();
---
<Base lang="zh" title="議程 | MOPM 2026">
  <div class="mx-auto max-w-6xl px-5 py-10 sm:px-8">
    <h1 class="mb-6 text-2xl font-bold tracking-tight text-accent sm:text-[28px]">議程 <span class="text-base font-medium text-muted">Programme</span></h1>
    <p class="mb-5 text-[13px] leading-relaxed text-muted">議程為主辦提供之最新版本，內容可能異動。標示 <strong class="font-semibold text-ink">TBA</strong> 者為講題或講者尚在確認中。</p>
    <div class="hidden md:block"><AgendaDesktop agenda={agenda} lang="zh" /></div>
    <div class="md:hidden"><AgendaMobile agenda={agenda} lang="zh" /></div>
  </div>
</Base>
