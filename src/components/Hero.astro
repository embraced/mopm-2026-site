---
import yaml from 'js-yaml';
import fs from 'node:fs';
import { t, type Lang } from '../lib/i18n';
const { lang } = Astro.props as { lang: Lang };
const c: any = yaml.load(fs.readFileSync('src/data/conference.yaml', 'utf8'));
const title = lang === 'zh' ? c.title_zh : c.title_en;
const date = lang === 'zh' ? c.date_zh : c.date_en;
const venue = lang === 'zh' ? c.venue_zh : c.venue_en;
const base = lang === 'en' ? '/en/' : '/';
---
<section class="bg-black text-white">
  <div class="mx-auto max-w-[1600px]">
    <img src={c.banner} alt={title} class="block w-full" fetchpriority="high" />
  </div>
  <div class="mx-auto max-w-3xl px-6 pb-9 pt-7 text-center">
    {/* 主標題／日期／地點已在 banner 圖上呈現；此處以 sr-only 保留給 SEO、螢幕閱讀器與文件大綱（結構化資料另見 EventSchema JSON-LD）。 */}
    <h1 class="sr-only">{title}　{date}　{venue}</h1>
    <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a
        href={base + '#register'}
        class="w-full rounded-lg bg-gradient-to-br from-accent to-teal-light px-8 py-3.5 text-center text-[15px] font-bold text-teal-deep shadow-[0_6px_16px_rgba(88,213,208,.35)] transition-transform hover:-translate-y-0.5 sm:w-auto"
      >{t(lang, 'hero.register')}</a>
      <a
        href={base + '#abstract'}
        class="w-full rounded-lg bg-gold px-8 py-3.5 text-center text-[15px] font-bold text-gold-contrast shadow-[0_6px_16px_rgba(201,168,106,.35)] transition-transform hover:-translate-y-0.5 sm:w-auto"
      >{t(lang, 'hero.submit')}</a>
      <a
        href={base + '#about'}
        class="w-full rounded-lg border-[1.5px] border-accent bg-white px-8 py-3 text-center text-[15px] font-semibold text-[#2E8F8B] transition-colors hover:bg-accent/10 sm:w-auto"
      >{t(lang, 'hero.learn')}</a>
    </div>
  </div>
</section>
