---
import yaml from 'js-yaml';
import fs from 'node:fs';
import sharp from 'sharp';
import type { Lang } from '../lib/i18n';
const { lang } = Astro.props as { lang: Lang };
const c: any = yaml.load(fs.readFileSync('src/data/conference.yaml', 'utf8'));
const title = lang === 'zh' ? c.title_zh : c.title_en;
const date = lang === 'zh' ? c.date_zh : c.date_en;
const venue = lang === 'zh' ? c.venue_zh : c.venue_en;

// banner 是 LCP 元素。手機不該下載 3200px 原圖：public/ 裡有 `<檔名>-<寬>w.webp` 縮圖就放進 srcset，
// 沒有就只用原圖（換 banner 時忘了產縮圖也不會壞，只是比較慢）。
// width/height 從原圖讀，讓瀏覽器在圖片下載前就保留高度，避免版面位移（CLS）。
const bannerFile = `public${c.banner}`;
const { width: bw, height: bh } = await sharp(bannerFile).metadata();
const [stem, ext] = [c.banner.replace(/\.[^.]+$/, ''), c.banner.match(/\.[^.]+$/)![0]];
const srcset = [800, 1200, 1600]
  .filter((w) => w < bw! && fs.existsSync(`public${stem}-${w}w${ext}`))
  .map((w) => `${stem}-${w}w${ext} ${w}w`)
  .concat(`${c.banner} ${bw}w`)
  .join(', ');
---
<section class="bg-black text-white">
  <div class="mx-auto max-w-[1600px]">
    <img src={c.banner} srcset={srcset} sizes="(min-width: 1600px) 1600px, 100vw"
      width={bw} height={bh} alt={title} class="block h-auto w-full" fetchpriority="high" />
  </div>
  {/* Desktop: title/date/venue are baked into the banner image; sr-only H1 kept for SEO,
      screen readers, and document outline (structured data also in EventSchema JSON-LD).
      Mobile: the wide banner text is too small, so surface a Noto Serif TC hero title.
      The three CTAs now live in the stats row (StatsStrip), aligned with the design. */}
  <h1 class="sr-only">{title}　{date}　{venue}</h1>
  <div class="px-6 pb-8 pt-6 text-center sm:hidden">
    <p class="font-serif text-[22px] font-black leading-snug text-white">{title}</p>
    <p class="mt-2 font-spectral text-sm italic text-white/70">{date}　·　{venue}</p>
  </div>
</section>
