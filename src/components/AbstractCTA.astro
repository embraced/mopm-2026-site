---
import yaml from 'js-yaml';
import fs from 'node:fs';
import { t, pick, type Lang } from '../lib/i18n';
import SectionHeading from './SectionHeading.astro';
const { lang } = Astro.props as { lang: Lang };
const c: any = yaml.load(fs.readFileSync('src/data/conference.yaml', 'utf8'));

const formUrl: string = c.abstract_form_url ?? '#';
const templateUrl: string = c.abstract_template ?? '';
const deadline = pick(c, 'abstract_deadline', lang);

const txt = lang === 'zh'
  ? {
      intro: '本次會議僅接受海報發表（Poster Presentation）。請依摘要範本撰寫，通過所屬學會審查後獲大會接受並編配論文編號。',
      deadlineLabel: '投稿截止',
      rulesTitle: '投稿規定',
      rules: [
        '一律線上投稿，僅接受海報發表。',
        '摘要以英文撰寫，長度 1 頁為限，上傳 PDF 檔。',
        '英文題目除介系詞外，每個單字字首皆須大寫。',
        '發表者須填中、英文姓名，並以底線標示發表者。',
        '發表者須為主辦六學會之一的有效會員，每篇摘要限投一個學會。',
      ],
      fileTitle: '檔案上傳規範',
      files: [
        '格式 PDF，大小 10 MB 以內。',
        '檔名格式：學會_姓名_學校（例：TPS_王大明_國立成功大學.pdf）。',
        '檔名請勿包含多餘的「.」符號（錯誤範例：ooxx.ooxx.pdf）。',
      ],
      submitBtn: '前往投稿表單',
      templateBtn: '下載摘要範本',
    }
  : {
      intro: 'Poster presentation is the only format. Prepare your abstract using the template; accepted abstracts (after review by the corresponding society) receive an abstract number.',
      deadlineLabel: 'Submission Deadline',
      rulesTitle: 'Submission Requirements',
      rules: [
        'All abstracts are submitted online; poster presentation only.',
        'Abstracts must be written in English, limited to one page, and uploaded as a PDF.',
        'Capitalize the first letter of each word in the title, except prepositions.',
        'Provide the presenting author’s name in both Chinese and English, with the presenting author underlined.',
        'The presenting author must be an active member of one of the six organizing societies; each abstract may be submitted to one society only.',
      ],
      fileTitle: 'Upload Instructions',
      files: [
        'Format: PDF, maximum 10 MB.',
        'File name: Society_Name_Affiliation (e.g., TPS_DaMing Wang_National Cheng Kung University.pdf).',
        'Do not include extra periods (".") in the file name (incorrect: ooxx.ooxx.pdf).',
      ],
      submitBtn: 'Go to Submission Form',
      templateBtn: 'Download Abstract Template',
    };
---
<section id="abstract" class="mx-auto max-w-6xl px-5 pt-10 sm:px-8">
  <SectionHeading title={t(lang, 'section.abstract')} subtitle={t(lang, 'section.abstractSub')} />
  <div class="relative overflow-hidden rounded-[20px] bg-gradient-to-br from-teal-deep to-[#12514D] p-8 text-[#E9EEF3] sm:p-12">
    <svg class="pointer-events-none absolute -right-10 -top-8 opacity-[.12]" width="260" height="260" viewBox="0 0 24 24" fill="none" stroke="#A5EEF1" stroke-width="1">
      <path d="M2 15c6.667-6 13.333 0 20-6" /><path d="M9 22c1.798-1.998 2.518-3.995 2.807-5.993" /><path d="M15 2c-1.798 1.998-2.518 3.995-2.807 5.993" /><path d="m17 6-2.5-2.5M14 8l-1-1M7 18l2.5 2.5M20 9l.5.5M6.5 12.5l1 1M16.5 10.5l1 1M10 16l1.5 1.5" />
    </svg>
    <div class="relative">
      <p class="mb-2 max-w-2xl text-base leading-relaxed text-[#CBD5E1]">{txt.intro}</p>
      {deadline && <p class="mb-7 text-sm text-teal-light"><span class="font-semibold">{txt.deadlineLabel}：</span>{deadline}</p>}
      <div class="mb-8 grid max-w-4xl gap-8 sm:grid-cols-2">
        <div>
          <h3 class="mb-3 text-[15px] font-bold text-white">{txt.rulesTitle}</h3>
          <ul class="flex list-none flex-col gap-2.5 p-0">
            {txt.rules.map((r) => <li class="flex gap-2 text-sm leading-relaxed"><span class="text-accent">•</span><span>{r}</span></li>)}
          </ul>
        </div>
        <div>
          <h3 class="mb-3 text-[15px] font-bold text-white">{txt.fileTitle}</h3>
          <ul class="flex list-none flex-col gap-2.5 p-0">
            {txt.files.map((r) => <li class="flex gap-2 text-sm leading-relaxed"><span class="text-accent">•</span><span>{r}</span></li>)}
          </ul>
        </div>
      </div>
      <div class="flex flex-wrap gap-3.5">
        <a href={formUrl} target="_blank" rel="noopener" class="rounded-lg bg-gradient-to-br from-accent to-teal-light px-7 py-3.5 text-[15px] font-bold text-teal-deep transition-transform hover:-translate-y-0.5">{txt.submitBtn}</a>
        {templateUrl && <a href={templateUrl} class="rounded-lg border-[1.5px] border-accent px-6 py-3 text-[15px] font-semibold text-teal-light transition-colors hover:bg-accent/10">{txt.templateBtn}</a>}
      </div>
    </div>
  </div>
</section>
