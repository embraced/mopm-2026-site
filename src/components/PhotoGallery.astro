---
import yaml from 'js-yaml';
import fs from 'node:fs';
import { t, type Lang } from '../lib/i18n';
import SectionHeading from './SectionHeading.astro';
const { lang } = Astro.props as { lang: Lang };
const data: any = yaml.load(fs.readFileSync('src/data/photos.yaml', 'utf8'));
const photos: any[] = data.photos ?? [];
---
{photos.length > 0 && (
  <section id="photos" class="mx-auto max-w-6xl px-5 pt-10 sm:px-8">
    <SectionHeading title={t(lang, 'section.photos')} subtitle={t(lang, 'section.photosSub')} />
    {photos.length === 1 ? (
      <div class="overflow-hidden rounded-2xl shadow-[0_2px_14px_rgba(30,41,59,.06)]">
        <img src={photos[0].src} alt={photos[0].alt ?? ''} class="block w-full" loading="lazy" />
      </div>
    ) : (
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4">
        {photos.map((p: any) => <img src={p.src} alt={p.alt ?? ''} class="aspect-square w-full rounded-2xl object-cover" loading="lazy" />)}
      </div>
    )}
  </section>
)}
