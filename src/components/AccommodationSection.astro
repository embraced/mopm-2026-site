---
import { t, type Lang } from '../lib/i18n';
import SectionHeading from './SectionHeading.astro';
const { lang } = Astro.props as { lang: Lang };

// 主辦洽談的特約住宿（imports/附件1~3，2026-07-30）。
// 這是研討會網站不是訂房網：只給飯店名、官網、訂房單三個連結，
// 房價／條件／取消規定一律留在訂房單 PDF 裡，不在站上複製一份會過期的資料。
interface Hotel {
  name: string;
  sub: string;
  site: string;
  form: string;
  formLabel: string;
}

const hotels: Hotel[] = lang === 'zh'
  ? [
      {
        name: '台南遠東香格里拉',
        sub: "Shangri-La's Far Eastern Plaza Hotel, Tainan",
        site: 'https://www.shangri-la.com/tc/tainan/fareasternplazashangrila/',
        form: '/hotel-shangri-la-booking-form-zh.pdf',
        formLabel: '訂房單 PDF',
      },
      {
        name: '台南老爺行旅',
        sub: 'The Place Tainan',
        site: 'https://www.hotelroyal.com.tw/zh-tw/tainan',
        form: '/hotel-the-place-tainan-booking-form-zh.pdf',
        formLabel: '訂房單 PDF',
      },
    ]
  : [
      {
        name: "Shangri-La's Far Eastern Plaza Hotel, Tainan",
        sub: '台南遠東香格里拉',
        site: 'https://www.shangri-la.com/tainan/fareasternplazashangrila/',
        form: '/hotel-shangri-la-booking-form-en.pdf',
        formLabel: 'Booking form (PDF)',
      },
      {
        name: 'The Place Tainan',
        sub: '台南老爺行旅',
        site: 'https://www.hotelroyal.com.tw/en-us/tainan',
        form: '/hotel-the-place-tainan-booking-form-zh.pdf',
        formLabel: 'Booking form (PDF, Chinese)',
      },
    ];

const txt = lang === 'zh'
  ? { site: '飯店官網', note: '兩間飯店提供大會特約價，方案與房價詳見訂房單。請自行與飯店聯繫訂房，大會不代訂。' }
  : { site: 'Hotel website', note: 'Both hotels offer a conference rate; see the booking form for details. Please book directly with the hotel — the conference does not handle reservations.' };
---
<section id="accommodation" class="mx-auto max-w-6xl px-5 pt-10 sm:px-8">
  <SectionHeading title={t(lang, 'section.accommodation')} subtitle={t(lang, 'section.accommodationSub')} />
  <div class="grid gap-4 sm:grid-cols-2">
    {hotels.map((h) => (
      <div class="rounded-xl bg-surface p-5 shadow-[0_2px_14px_rgba(30,41,59,.06)]">
        <h3 class="text-base font-bold leading-snug text-ink">{h.name}</h3>
        <p class="mt-0.5 text-[13px] leading-snug text-muted">{h.sub}</p>
        <div class="mt-3.5 flex flex-wrap gap-2">
          <a href={h.site} target="_blank" rel="noopener" class="rounded-lg border border-line px-3 py-1.5 text-[13px] font-medium text-ink transition-colors hover:border-accent hover:text-accent">{txt.site} ↗</a>
          <a href={h.form} target="_blank" rel="noopener" class="rounded-lg bg-gradient-to-br from-accent to-teal-light px-3 py-1.5 text-[13px] font-bold text-teal-deep transition-transform hover:-translate-y-0.5">{h.formLabel}</a>
        </div>
      </div>
    ))}
  </div>
  <p class="mt-3 text-xs leading-relaxed text-muted">{txt.note}</p>
</section>
