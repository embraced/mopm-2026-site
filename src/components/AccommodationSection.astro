---
import { t, type Lang } from '../lib/i18n';
import SectionHeading from './SectionHeading.astro';
const { lang } = Astro.props as { lang: Lang };

// 主辦洽談的特約住宿方案（imports/附件1~3，2026-07-30）。
// 只放摘要 + 訂房單下載：完整房價表在 PDF 裡，飯店保留改價權利，上站數字維護風險高。
// 文案沿用 TransportSection 的做法（元件內 lang 條件字面值），長段落不進 i18n json。
interface Hotel {
  name: string;
  sub: string;
  deal: string;
  rows: [string, string][];
  contact: string;
  email: string;
  tel: string;
  links: { label: string; href: string; primary?: boolean }[];
}

const PDF_SHANGRILA_ZH = '/hotel-shangri-la-booking-form-zh.pdf';
const PDF_SHANGRILA_EN = '/hotel-shangri-la-booking-form-en.pdf';
const PDF_THEPLACE_ZH = '/hotel-the-place-tainan-booking-form-zh.pdf';
const SHANGRILA_SITE_ZH = 'https://www.shangri-la.com/tc/tainan/fareasternplazashangrila/';
const SHANGRILA_SITE_EN = 'https://www.shangri-la.com/tainan/fareasternplazashangrila/';

const hotels: Hotel[] = lang === 'zh'
  ? [
      {
        name: '台南遠東香格里拉',
        sub: "Shangri-La's Far Eastern Plaza Hotel, Tainan",
        deal: '6 種房型當日 Flexible Rate 85 折，含早餐',
        rows: [
          ['適用日期', '2026/11/13（五）– 11/15（日）'],
          ['房價條件', '房價另加 10% 服務費與 5% 稅；優惠不適用專案及套裝行程'],
          ['訂房方式', '須信用卡保證（收到飯店線上連結後 48 小時內完成）；房型先到先得，收到訂房確認單才算完成'],
          ['取消規定', '入住日 72 小時前取消免費，逾期收一晚房費'],
          ['入住 / 退房', '16:00 / 12:00；全館免費無線網路'],
        ],
        contact: 'Marco Huang（業務總監）',
        email: 'marco.huang@shangri-la.com',
        tel: '+886 6 702 8888 #6818',
        links: [
          { label: '訂房單（中文 PDF）', href: PDF_SHANGRILA_ZH, primary: true },
          { label: 'RV Form (English PDF)', href: PDF_SHANGRILA_EN },
          { label: '飯店官網', href: SHANGRILA_SITE_ZH },
        ],
      },
      {
        name: '台南老爺行旅',
        sub: 'The Place Tainan',
        deal: '5 種房型專案價 NT$3,245 起／晚，含早餐',
        rows: [
          ['適用日期', '11/13（五）、11/14（六）兩晚，11/15（日）退房'],
          ['房價條件', '已含 5% 稅與 10% 服務費，依房型人數含早餐；不得與其他優惠併用'],
          ['訂房截止', '11/3（二）前完成訂房；需總房價 30% 訂金方保留房間'],
          ['房型數量', '各房型數量有限，依訂單與訂金到達時間排序'],
          ['入住 / 退房', '15:00 / 11:00；每房免費停車 1 台至退房日 12:00'],
        ],
        contact: '陳映汝 Rita Chen',
        email: 'rita.chen@tn.hotelroyal.com.tw',
        tel: '06-236-1680 #163',
        links: [{ label: '訂房書（中文 PDF）', href: PDF_THEPLACE_ZH, primary: true }],
      },
    ]
  : [
      {
        name: "Shangri-La's Far Eastern Plaza Hotel, Tainan",
        sub: '台南遠東香格里拉',
        deal: '15% off the prevailing Flexible Rate, breakfast included (6 room types)',
        rows: [
          ['Dates', '13 Nov (Fri) – 15 Nov (Sun), 2026'],
          ['Rate terms', 'Subject to 10% service charge and 5% VAT; cannot be combined with other packages or promotions'],
          ['How to book', 'Credit-card guarantee required (complete the hotel’s online link within 48 hours); rooms are first-come, first-served and are not confirmed until the hotel issues a confirmation'],
          ['Cancellation', 'Free up to 72 hours before arrival; later cancellations incur one room night’s charge'],
          ['Check-in / out', '16:00 / 12:00; complimentary Wi-Fi throughout the hotel'],
        ],
        contact: 'Marco Huang (Director of Sales & Events)',
        email: 'marco.huang@shangri-la.com',
        tel: '+886 6 702 8888 #6818',
        links: [
          { label: 'RV Form (English PDF)', href: PDF_SHANGRILA_EN, primary: true },
          { label: 'Booking form (Chinese PDF)', href: PDF_SHANGRILA_ZH },
          { label: 'Hotel website', href: SHANGRILA_SITE_EN },
        ],
      },
      {
        name: 'The Place Tainan',
        sub: '台南老爺行旅',
        deal: 'Conference rate from NT$3,245 per night, breakfast included (5 room types)',
        rows: [
          ['Dates', 'Nights of 13 Nov (Fri) and 14 Nov (Sat); check out 15 Nov (Sun)'],
          ['Rate terms', '5% tax and 10% service charge already included; breakfast for the room’s occupancy; cannot be combined with other offers'],
          ['Deadline', 'Bookings must be completed by 3 Nov (Tue); a 30% deposit is required to hold the room'],
          ['Availability', 'Limited rooms per type, allocated by order and deposit arrival time'],
          ['Check-in / out', '15:00 / 11:00; one complimentary parking space per room until 12:00 on departure day'],
        ],
        contact: 'Rita Chen',
        email: 'rita.chen@tn.hotelroyal.com.tw',
        tel: '+886 6 236 1680 #163',
        links: [{ label: 'Booking form (Chinese only, PDF)', href: PDF_THEPLACE_ZH, primary: true }],
      },
    ];

const footnote = lang === 'zh'
  ? '訂房請直接與飯店聯繫，大會不代訂。房價與條件以飯店最新公告為準。'
  : 'Please book directly with the hotel — the conference does not handle reservations. Rates and terms are subject to the hotel’s latest announcement.';
---
<section id="accommodation" class="mx-auto max-w-6xl px-5 pt-10 sm:px-8">
  <SectionHeading title={t(lang, 'section.accommodation')} subtitle={t(lang, 'section.accommodationSub')} />
  <div class="grid gap-6 md:grid-cols-2 md:items-start">
    {hotels.map((h) => (
      <div class="flex h-full flex-col rounded-2xl bg-surface p-7 shadow-[0_2px_14px_rgba(30,41,59,.06)]">
        <h3 class="text-lg font-bold leading-snug text-ink">{h.name}</h3>
        <p class="mt-0.5 text-[13px] text-muted">{h.sub}</p>

        <p class="mt-4 rounded-xl border border-accent/35 bg-accent/[.07] px-4 py-2.5 text-[13.5px] font-semibold leading-snug text-ink">
          {h.deal}
        </p>

        <dl class="mt-4 flex flex-col">
          {h.rows.map(([k, v], i) => (
            <div class={`flex flex-col gap-0.5 py-2.5 sm:flex-row sm:gap-4 ${i > 0 ? 'border-t border-line' : ''}`}>
              <dt class="shrink-0 text-xs font-semibold text-muted sm:w-24 sm:pt-0.5">{k}</dt>
              <dd class="m-0 text-[13.5px] leading-relaxed text-ink">{v}</dd>
            </div>
          ))}
        </dl>

        <div class="mt-4 border-t border-line pt-4 text-[13px] leading-relaxed text-muted">
          <div class="font-semibold text-ink">{h.contact}</div>
          <a href={`mailto:${h.email}`} class="block break-all transition-colors hover:text-accent">{h.email}</a>
          <a href={`tel:${h.tel.replace(/[^+\d]/g, '')}`} class="block transition-colors hover:text-accent">{h.tel}</a>
        </div>

        <div class="mt-5 flex flex-wrap gap-2.5">
          {h.links.map((l) => (
            l.primary ? (
              <a href={l.href} target="_blank" rel="noopener" class="rounded-lg bg-gradient-to-br from-accent to-teal-light px-4 py-2 text-[13px] font-bold text-teal-deep transition-transform hover:-translate-y-0.5">{l.label}</a>
            ) : (
              <a href={l.href} target="_blank" rel="noopener" class="rounded-lg border border-line px-4 py-2 text-[13px] font-medium text-ink transition-colors hover:border-accent hover:text-accent">{l.label}</a>
            )
          ))}
        </div>
      </div>
    ))}
  </div>
  <p class="mt-4 text-xs leading-relaxed text-muted">{footnote}</p>
</section>
