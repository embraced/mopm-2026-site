---
// Consistent section heading: teal zh title + muted subtitle, with an optional
// right-aligned action (e.g. "完整議程 →") passed via the default slot.
interface Props {
  title: string;
  subtitle?: string;
  id?: string;
}
const { title, subtitle, id } = Astro.props as Props;
const hasAction = Astro.slots.has('default');
---
<div class="mb-6 flex flex-wrap items-baseline gap-x-3 gap-y-1" id={id}>
  <h2 class="m-0 font-serif text-2xl font-black tracking-tight text-accent sm:text-[28px]">{title}</h2>
  {subtitle && <span class="font-spectral text-base italic text-muted">{subtitle}</span>}
  {hasAction && <div class="ml-auto"><slot /></div>}
</div>
