---
import yaml from 'js-yaml';
import fs from 'node:fs';
import { type Lang } from '../lib/i18n';
const { lang } = Astro.props as { lang: Lang };
const c: any = yaml.load(fs.readFileSync('src/data/conference.yaml', 'utf8'));

/*
  海報投稿通過名單公告 — 與 DeadlineNotice 同一個位置、同一套 gold 樣式，
  接手 9/25 截止後空出來的「banner 下第一眼」。

  渲染條件是 conference.yaml 的 poster_list_url 還在；下架 = 刪掉那一行
  （PosterSection 的名單連結也會一起消失）。名單是主辦的 PDF 原檔，
  不在站上轉成 HTML 表格：主辦會改版，原檔覆蓋同名檔即更新。
*/
const url: string | undefined = c.poster_list_url;

const txt = lang === 'zh'
  ? { tag: '最新公告', lead: '海報投稿通過名單已公布', sub: '請至名單確認您的海報', cta: '查看名單 (PDF)' }
  : { tag: 'Announcement', lead: 'Accepted poster list is now available', sub: 'Please check your poster in the list', cta: 'View List (PDF)' };
---
{url && (
  <aside class="bg-gold text-gold-contrast" aria-label={txt.tag}>
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-x-5 gap-y-3 px-5 py-4 sm:justify-between sm:px-8">
      <div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-2">
        <span class="inline-flex shrink-0 items-center gap-1.5 rounded-full bg-gold-contrast px-3 py-1 text-xs font-bold text-gold">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 11v3a1 1 0 0 0 1 1h2l3.29 3.29A1 1 0 0 0 11 17.6V6.4a1 1 0 0 0-1.71-.7L6 9H4a1 1 0 0 0-1 1Z" /><path d="M16 9a5 5 0 0 1 0 6" />
          </svg>
          {txt.tag}
        </span>
        <p class="flex flex-wrap items-center justify-center gap-x-2.5 gap-y-1 text-[15px] leading-relaxed sm:justify-start">
          <span class="whitespace-nowrap font-bold">{txt.lead}</span>
          <span class="whitespace-nowrap opacity-75">{txt.sub}</span>
        </p>
      </div>
      <a
        href={url}
        target="_blank"
        rel="noopener"
        class="shrink-0 rounded-lg bg-gold-contrast px-5 py-2.5 text-sm font-bold text-gold transition-transform hover:-translate-y-0.5"
      >{txt.cta} →</a>
    </div>
  </aside>
)}
