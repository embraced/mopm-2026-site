---
import { t, type Lang } from '../lib/i18n';
import SectionHeading from './SectionHeading.astro';
import Logo from './Logo.astro';
const { lang } = Astro.props as { lang: Lang };
const body = lang === 'zh'
  ? '多體學與精準醫學是一門跨領域整合的前沿科學，涵蓋體學技術創新、資料分析與轉譯應用，串聯基礎研究、轉譯醫學乃至臨床實踐，由六大學會聯合主辦。'
  : 'Multi-omics and precision medicine is a frontier interdisciplinary field spanning technology innovation, data analysis and translational application — connecting basic research, translational medicine, and clinical practice. Jointly organized by six societies.';
---
<section id="about" class="mx-auto max-w-6xl px-5 pt-10 sm:px-8">
  <SectionHeading title={t(lang, 'section.about')} subtitle={t(lang, 'section.aboutSub')} />
  <div class="relative overflow-hidden rounded-2xl bg-surface p-8 shadow-[0_2px_14px_rgba(30,41,59,.06)] sm:p-9">
    <Logo size={200} stroke="rgb(var(--color-accent))" strokeWidth={1} class="pointer-events-none absolute -bottom-8 -right-8 opacity-[.06]" />
    <p class="relative m-0 max-w-3xl text-[17px] leading-[1.85] text-muted">{body}</p>
  </div>
</section>
