---
import { t, type Lang } from '../lib/i18n';
const { lang } = Astro.props as { lang: Lang };
const base = lang === 'en' ? '/en/' : '/';

// Lucide-style line icons (calendar / mic / users / grid)
const icons: Record<string, string> = {
  days: '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>',
  speakers: '<path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2M12 19v3"/>',
  societies: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>',
  sessions: '<path d="M2 3h20M3 3v11a1 1 0 0 0 1 1h16a1 1 0 0 0 1-1V3M8 21h8M12 15v6M8.5 8.5 11 11l4.5-4.5"/>',
};

const stats = [
  { key: 'days', num: '2' },
  { key: 'speakers', num: '3' },
  { key: 'societies', num: '6' },
  { key: 'sessions', num: '12' },
];
---
<section class="mx-auto max-w-6xl px-5 pt-9 sm:px-8">
  <div class="flex flex-wrap items-center gap-x-6 gap-y-6">
    {/* Quick facts — icon + text groups, no cards (aligns with the design) */}
    <div class="flex flex-1 flex-wrap items-center justify-center gap-x-9 gap-y-5 sm:justify-start">
      {stats.map((s) => (
        <div class="flex items-center gap-3.5">
          <svg
            width="34"
            height="34"
            viewBox="0 0 24 24"
            fill="none"
            stroke="rgb(var(--color-accent))"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="shrink-0"
            set:html={icons[s.key]}
          />
          <div>
            <div class="text-[26px] font-extrabold leading-none text-accent">{s.num}</div>
            <div class="mt-1 text-sm font-semibold text-ink">{t(lang, 'stats.' + s.key)}</div>
            <div class="text-[11px] text-muted">{t(lang, 'stats.' + s.key + 'Sub')}</div>
          </div>
        </div>
      ))}
    </div>
    {/* CTAs — right side of the stats row */}
    <div class="flex w-full flex-wrap items-center justify-center gap-3 sm:w-auto sm:justify-start">
      <a
        href={base + '#register'}
        class="rounded-lg bg-gradient-to-br from-accent to-teal-light px-7 py-3 text-[15px] font-bold text-teal-deep shadow-[0_6px_16px_rgba(88,213,208,.35)] transition-transform hover:-translate-y-0.5"
      >{t(lang, 'hero.register')}</a>
      <a
        href={base + '#abstract'}
        class="rounded-lg bg-gold px-7 py-3 text-[15px] font-bold text-gold-contrast shadow-[0_6px_16px_rgba(201,168,106,.35)] transition-transform hover:-translate-y-0.5"
      >{t(lang, 'hero.submit')}</a>
      <a
        href={base + '#about'}
        class="rounded-lg border-[1.5px] border-accent bg-white px-6 py-2.5 text-[15px] font-semibold text-[#2E8F8B] transition-colors hover:bg-accent/10"
      >{t(lang, 'hero.learn')}</a>
    </div>
  </div>
</section>
