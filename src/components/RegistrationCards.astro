---
import yaml from 'js-yaml';
import fs from 'node:fs';
import { t, pick, type Lang } from '../lib/i18n';
const { lang } = Astro.props as { lang: Lang };
const socs: any[] = yaml.load(fs.readFileSync('src/data/societies.yaml', 'utf8')) as any[];
const c: any = yaml.load(fs.readFileSync('src/data/conference.yaml', 'utf8'));
const fees: any = yaml.load(fs.readFileSync('src/data/fees.yaml', 'utf8'));

const deadline = pick(c, 'register_deadline', lang);
const includes = pick(fees, 'includes', lang);
const nonmemberUrl: string = c.nonmember_register_url ?? '#';

const txt = lang === 'zh'
  ? {
      deadlineLabel: '報名期間',
      feeHeadItem: '身分',
      feeHeadPrice: '費用',
      memberTitle: '學會會員',
      memberNote: '請透過所屬學會的報名系統或聯絡窗口完成報名：',
      nonmemberTitle: '非會員',
      nonmemberNote: '非六學會會員請由線上表單完成報名。',
      nonmemberBtn: '前往非會員報名',
    }
  : {
      deadlineLabel: 'Registration Period',
      feeHeadItem: 'Category',
      feeHeadPrice: 'Fee',
      memberTitle: 'Society Members',
      memberNote: 'Register through your society’s registration system or contact person:',
      nonmemberTitle: 'Non-Members',
      nonmemberNote: 'Participants who are not members of the six organizing societies may register online.',
      nonmemberBtn: 'Non-Member Registration',
    };
const money = (n: number) => `NT$ ${n.toLocaleString('en-US')}`;
---
<section id="register" class="mx-auto max-w-5xl px-4 py-16">
  <h2 class="mb-6 text-2xl font-bold text-accent">{t(lang, 'section.register')}</h2>

  {deadline && (
    <p class="mb-8 text-sm text-muted">
      <span class="font-semibold text-ink">{txt.deadlineLabel}：</span>{deadline}
    </p>
  )}

  <!-- 費用表 -->
  <div class="mb-4 overflow-hidden rounded-lg border border-line">
    <table class="w-full text-left text-sm">
      <thead class="bg-line/40 text-muted">
        <tr>
          <th class="px-4 py-2 font-semibold">{txt.feeHeadItem}</th>
          <th class="px-4 py-2 text-right font-semibold">{txt.feeHeadPrice}</th>
        </tr>
      </thead>
      <tbody>
        {fees.items.map((it: any) => (
          <tr class="border-t border-line">
            <td class="px-4 py-2">
              <span class="text-xs text-muted">{pick(it, 'group', lang)}</span>
              <span class="mx-1 text-muted">·</span>
              <span class="text-ink">{pick(it, 'label', lang)}</span>
            </td>
            <td class="px-4 py-2 text-right font-semibold tabular-nums text-ink">{money(it.price)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  {includes && <p class="mb-12 text-xs leading-relaxed text-muted">{includes}</p>}

  <!-- 會員報名 -->
  <h3 class="mb-2 text-lg font-bold text-ink">{txt.memberTitle}</h3>
  <p class="mb-6 text-sm text-muted">{txt.memberNote}</p>
  <div class="mb-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {socs.map((s) => (
      <a href={s.register_url} target="_blank" rel="noopener" class="flex items-center gap-3 rounded-lg border border-line bg-surface p-4 hover:border-accent">
        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded bg-line text-xs font-bold">{s.logo ? <img src={s.logo} alt={s.code} class="h-12 w-12 object-contain" /> : s.code}</div>
        <span class="text-sm font-medium">{pick(s, 'name', lang)}</span>
      </a>
    ))}
  </div>

  <!-- 非會員報名 -->
  <h3 class="mb-2 text-lg font-bold text-ink">{txt.nonmemberTitle}</h3>
  <p class="mb-6 text-sm text-muted">{txt.nonmemberNote}</p>
  <a href={nonmemberUrl} target="_blank" rel="noopener" class="inline-block rounded-lg bg-accent px-6 py-3 font-semibold text-accent-contrast hover:opacity-90">{txt.nonmemberBtn}</a>
</section>
