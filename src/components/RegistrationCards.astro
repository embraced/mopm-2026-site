---
import yaml from 'js-yaml';
import fs from 'node:fs';
import { t, pick, type Lang } from '../lib/i18n';
import SectionHeading from './SectionHeading.astro';
const { lang } = Astro.props as { lang: Lang };
const socs: any[] = yaml.load(fs.readFileSync('src/data/societies.yaml', 'utf8')) as any[];
const c: any = yaml.load(fs.readFileSync('src/data/conference.yaml', 'utf8'));
const fees: any = yaml.load(fs.readFileSync('src/data/fees.yaml', 'utf8'));

const deadline = pick(c, 'register_deadline', lang);
const includes = pick(fees, 'includes', lang);
const nonmemberUrl: string = c.nonmember_register_url ?? '#';

const txt = lang === 'zh'
  ? {
      deadlineLabel: '報名期間',
      feeTitle: '費用一覽',
      memberTitle: '學會會員報名',
      memberNote: '請透過所屬學會的報名系統或聯絡窗口完成報名。',
      nonmemberTitle: '非會員報名',
      nonmemberNote: '非六學會會員請由線上表單報名。',
      nonmemberBtn: '前往報名',
      noLinkNote: '報名連結尚未提供，請洽學會',
    }
  : {
      deadlineLabel: 'Registration Period',
      feeTitle: 'Fees',
      memberTitle: 'Society Member Registration',
      memberNote: 'Register through your society’s registration system or contact person.',
      nonmemberTitle: 'Non-Member Registration',
      nonmemberNote: 'Participants who are not members of the six societies may register online.',
      nonmemberBtn: 'Register',
      noLinkNote: 'Link not yet available — contact the society',
    };
const money = (n: number) => `NT$ ${n.toLocaleString('en-US')}`;
---
<section id="register" class="mx-auto max-w-6xl px-5 pt-10 sm:px-8">
  <SectionHeading title={t(lang, 'section.register')} subtitle={t(lang, 'section.registerSub')} />
  {deadline && (
    <p class="mb-6 text-sm text-muted"><span class="font-semibold text-ink">{txt.deadlineLabel}：</span>{deadline}</p>
  )}

  <div class="grid gap-6 lg:grid-cols-[1fr_1.15fr] lg:items-start">
    <!-- Fee table -->
    <div class="rounded-2xl bg-surface p-7 shadow-[0_2px_14px_rgba(30,41,59,.06)]">
      <h3 class="mb-4 text-lg font-bold text-ink">{txt.feeTitle}</h3>
      <div class="flex flex-col">
        {fees.items.map((it: any, i: number) => (
          <div class={`flex items-center justify-between py-3 ${i < fees.items.length - 1 ? 'border-b border-line' : ''}`}>
            <span class="text-sm">
              <span class={`text-xs ${it.addon ? 'font-semibold text-gold' : 'text-muted'}`}>{pick(it, 'group', lang)}</span>
              <span class="mx-1 text-muted">·</span>
              <span class="text-ink">{pick(it, 'label', lang)}</span>
            </span>
            <span class="font-bold tabular-nums text-ink">{money(it.price)}</span>
          </div>
        ))}
      </div>
      {includes && <p class="mt-4 text-xs leading-relaxed text-muted">{includes}</p>}
    </div>

    <!-- Society + non-member -->
    <div class="rounded-2xl bg-surface p-7 shadow-[0_2px_14px_rgba(30,41,59,.06)]">
      <h3 class="mb-1.5 text-lg font-bold text-ink">{txt.memberTitle}</h3>
      <p class="mb-4 text-[13px] text-muted">{txt.memberNote}</p>
      <div class="grid gap-3 sm:grid-cols-2">
        {socs.map((s) => {
          // register_url 留空＝該學會尚未提供連結，渲染成不可點的卡片。
          // 寧可沒有連結，也不要掛一個點了到不了報名頁的死連結。
          const Card = s.register_url ? 'a' : 'div';
          const linkAttrs = s.register_url
            ? { href: s.register_url, target: '_blank', rel: 'noopener' }
            : {};
          return (
            <Card
              {...linkAttrs}
              class={`flex items-center gap-3 rounded-xl border border-line p-3 ${
                s.register_url ? 'transition-colors hover:border-accent' : 'cursor-default'
              }`}
            >
              <div class="flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded bg-white/95 p-1 text-[11px] font-bold text-teal-deep shadow-[0_1px_4px_rgba(15,23,33,.1)] ring-1 ring-black/[.04]">
                {s.logo ? <img src={s.logo} alt={s.code} class="max-h-full max-w-full object-contain" /> : s.code}
              </div>
              <span class="flex flex-col">
                <span class="text-[13px] font-medium leading-snug text-ink">{pick(s, 'name', lang)}</span>
                {!s.register_url && (
                  <span class="mt-0.5 text-[11px] leading-snug text-muted">{txt.noLinkNote}</span>
                )}
              </span>
            </Card>
          );
        })}
      </div>
      <div class="mt-5 flex items-center justify-between gap-4 border-t border-line pt-5">
        <div>
          <div class="text-[15px] font-bold text-ink">{txt.nonmemberTitle}</div>
          <div class="text-[13px] text-muted">{txt.nonmemberNote}</div>
        </div>
        <a href={nonmemberUrl} target="_blank" rel="noopener" class="whitespace-nowrap rounded-lg bg-gradient-to-br from-accent to-teal-light px-5 py-2.5 text-sm font-bold text-teal-deep transition-transform hover:-translate-y-0.5">{txt.nonmemberBtn}</a>
      </div>
    </div>
  </div>
</section>
