---
// 首頁議程區塊 = 完整議程（2026-10-16 主辦要求合併，不再另開 /agenda 頁；/agenda 轉址到 /#agenda）。
// 桌機用 AgendaDesktop 三欄表格、手機用 AgendaMobile 卡片；Day 1／Day 2 用分頁鈕切換，
// 兩個元件每天的 <section> 都帶 data-agenda-day，切換時一起顯示／隱藏。停用 JS 時兩天都顯示。
import { loadAgenda } from '../lib/agenda';
import { t, type Lang } from '../lib/i18n';
import SectionHeading from './SectionHeading.astro';
import AgendaDesktop from './AgendaDesktop.astro';
import AgendaMobile from './AgendaMobile.astro';
const { lang } = Astro.props as { lang: Lang };
const agenda = loadAgenda();
---
<section id="agenda" class="mx-auto max-w-6xl px-5 pt-10 sm:px-8">
  <SectionHeading title={t(lang, 'section.agenda')} subtitle={t(lang, 'agenda.note')} />

  <div class="agenda-full rounded-2xl bg-surface p-4 shadow-[0_2px_14px_rgba(30,41,59,.06)] sm:p-8">
    {agenda.days.length > 1 && (
      <div class="mb-4 inline-flex rounded-xl bg-bg p-1">
        {agenda.days.map((day, di) => (
          <button
            type="button"
            class="ag-tab rounded-lg px-4 py-2 text-sm font-semibold transition-all data-[on=false]:text-muted data-[on=true]:bg-gradient-to-br data-[on=true]:from-accent data-[on=true]:to-teal-light data-[on=true]:text-teal-deep data-[on=true]:shadow-[0_2px_6px_rgba(88,213,208,.3)]"
            data-day={di}
            data-on={di === 0 ? 'true' : 'false'}
          >{lang === 'zh' ? day.label_zh : day.label_en}</button>
        ))}
      </div>
    )}
    <p class="mb-4 text-[13px] leading-relaxed text-muted">
      {lang === 'zh'
        ? <>標示 <strong class="font-semibold text-ink">TBA</strong> 者為講題或講者尚在確認中。</>
        : <>Items marked <strong class="font-semibold text-ink">TBA</strong> have a talk title or speaker still being confirmed.</>}
    </p>
    <div class="hidden md:block"><AgendaDesktop agenda={agenda} lang={lang} /></div>
    <div class="md:hidden"><AgendaMobile agenda={agenda} lang={lang} /></div>
  </div>
</section>

<style>
  /* 分頁鈕已經寫了日期，元件裡每天的日期小標題就不再顯示 */
  .agenda-full :global([data-agenda-day] > h3) { display: none; }
</style>

<script>
  const root = document.querySelector<HTMLElement>('.agenda-full');
  const tabs = root?.querySelectorAll<HTMLButtonElement>('.ag-tab') ?? [];
  if (root && tabs.length) {
    const show = (d: string) => {
      tabs.forEach((x) => { x.dataset.on = String(x.dataset.day === d); });
      root.querySelectorAll<HTMLElement>('[data-agenda-day]').forEach((s) => {
        s.style.display = s.dataset.agendaDay === d ? '' : 'none';
      });
    };
    tabs.forEach((tab) => tab.addEventListener('click', () => show(tab.dataset.day!)));
    show('0');
  }
</script>
