---
import yaml from 'js-yaml';
import fs from 'node:fs';
import { t, pick, type Lang } from '../lib/i18n';
import SectionHeading from './SectionHeading.astro';
const { lang } = Astro.props as { lang: Lang };
const speakers: any[] = yaml.load(fs.readFileSync('src/data/speakers.yaml', 'utf8')) as any[];
// 拉丁名不需翻譯，所以 name 是單一欄位；只有漢字姓名（吉田信介）補 name_en 羅馬拼音給英文頁用。
const speakerName = (s: any) => (lang === 'en' && s.name_en) || s.name;
---
<section id="speakers" class="mx-auto max-w-6xl px-5 pt-10 sm:px-8">
  <SectionHeading title={t(lang, 'section.speakers')} subtitle={t(lang, 'section.speakersSub')} />
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {speakers.map((s) => (
      <article class="flex flex-col items-center rounded-2xl bg-surface p-7 text-center shadow-[0_2px_14px_rgba(30,41,59,.06)]">
        <div class="mb-4 flex h-24 w-24 items-center justify-center rounded-full border-[3px] border-surface bg-gradient-to-br from-line to-bg shadow-[0_4px_12px_rgba(30,41,59,.1)]">
          {s.photo
            ? <img src={s.photo} alt={speakerName(s)} width="96" height="96" loading="lazy" decoding="async" class="h-24 w-24 rounded-full object-cover" />
            : <svg width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="rgb(var(--color-muted))" stroke-width="1.4"><circle cx="12" cy="8" r="4"/><path d="M4 21v-1a6 6 0 0 1 6-6h4a6 6 0 0 1 6 6v1"/></svg>}
        </div>
        <div class="text-xl font-bold text-ink">{speakerName(s)}</div>
        <div class="mt-1 text-sm font-semibold text-accent">{pick(s, 'title', lang)}</div>
        {pick(s, 'affiliation', lang) && <div class="mt-0.5 text-[13px] leading-snug text-muted">{pick(s, 'affiliation', lang)}</div>}
        <div class="my-4 h-px w-10 bg-line"></div>
        <p class="text-sm leading-relaxed text-muted">{pick(s, 'bio', lang)}</p>
        {s.links && s.links.length > 0 && (
          <div class="mt-4 flex flex-wrap justify-center gap-2">
            {s.links.map((l: any) => (
              <a
                href={l.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center rounded-full border border-line px-3 py-1 text-xs font-medium text-accent transition-colors hover:bg-accent hover:text-accent-contrast"
              >{pick(l, 'label', lang)} ↗</a>
            ))}
          </div>
        )}
      </article>
    ))}
  </div>
</section>
